# Frontend env (Vite). Copy to web/.env. Optional.

# Backend base URL (defaults to the dev proxy /api). Set for a deployed API.
# VITE_API_BASE=https://your-api.example.com

# Google OAuth client ID for the live Gmail connector (read-only inbox triage).
# Create at console.cloud.google.com → enable Gmail API → OAuth client (Web) →
# scope gmail.readonly → add yourself as a test user. Leave blank to hide the feature.
VITE_GOOGLE_CLIENT_ID=
