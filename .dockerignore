# Keep secrets, local envs, and build junk OUT of the Docker build context.

# secrets — NEVER send to the build context (passed at runtime via env_file)
.env
.env.*
!.env.example
client_secret_*.json
*.apps.googleusercontent.com.json

# python virtualenvs (host-only; images install their own deps)
.venv
.venv*/
venv/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# node / web build artifacts (web is rebuilt inside the image)
web/node_modules/
web/dist/
npm-debug.log*
yarn-error.log*

# data / generated
*.db
demo/results.json

# vcs / editor / os
.git
.gitignore
.idea/
.vscode/
.DS_Store
*.swp

# docs & infra not needed at build time
docs/
README.md
