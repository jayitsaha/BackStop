# Copy to .env and fill in. NEVER commit the real .env.

# --- LLM: NVIDIA NIM (OpenAI-compatible) ---
# One or more NIM API keys, comma-separated (rotated for throughput).
NVIDIA_API_KEYS=nvapi-xxxxx,nvapi-yyyyy
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Default model for agents + the checker/analyzer.
NVIDIA_MODEL=openai/gpt-oss-20b
# Verifier (backup checker) and the stronger model it escalates to.
BACKSTOP_CHECKER_MODEL=openai/gpt-oss-20b
BACKSTOP_ESCALATION_MODEL=nvidia/nemotron-3-super-120b-a12b
# Multimodal model for Inbox Guard image uploads.
BACKSTOP_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# --- Firebase (Auth + Realtime Database) ---
FIREBASE_API_KEY=your-firebase-web-apiKey
FIREBASE_DB_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_DB_SECRET=your-realtime-database-secret
FIREBASE_PROJECT_ID=your-project-id

# signing salt for KYA agent IDs (any random string)
BACKSTOP_JWT_SECRET=change-me
